# Resemblio API - environment variable example
#
# Production values live in /opt/resemblio-api/.env (loaded by the
# systemd unit). The shared workspace credentials file at
# _credentials/credentials.env supplies dev/test values via
# app/config.py:load_project_env() when the live unit is not present.
#
# Do NOT commit a populated copy of this file.

# Required: 32+ character pepper used to hash API keys before storage.
RESEMBLIO_KEY_PEPPER=

# Optional: previous pepper during a rotation. Unset in steady state.
RESEMBLIO_KEY_PEPPER_OLD=

# Database URL. Postgres in prod; SQLite in tests / local dev.
RESEMBLIO_DB_URL=

# Stripe (TEST mode shown; LIVE values rotate the alias content, not the alias name).
RESEMBLIO_STRIPE_MODE=test
STRIPE_RESTRICTED_KEY_RESEMBLIO_TEST=
STRIPE_WEBHOOK_SECRET_RESEMBLIO_TEST=

# Resend transactional email.
RESEND_API_KEY=
RESEMBLIO_RESEND_FROM_EMAIL=Resemblio <hello@resemblio.com>

# R2 object storage.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
RESEMBLIO_R2_BUCKET=resemblio-extractions
RESEMBLIO_R2_REGION=auto

# S3 internal-auth surface (BFF magic-link signup/login).
# REQUIRED in production. The /v1/internal/auth/* routes return 503 when
# this is unset, so a forgotten value fails closed rather than open. The
# Next.js web process sends this verbatim in the X-Internal-Auth header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RESEMBLIO_INTERNAL_AUTH_SECRET=

# Base URL used to assemble magic-link click targets when the caller
# does not supply ``link_base``. Defaults to https://resemblio.com.
RESEMBLIO_WEB_APP_BASE_URL=https://resemblio.com

# Misc.
RESEMBLIO_KEY_ENV=live
RESEMBLIO_LOG_LEVEL=INFO
RESEMBLIO_TOPUP_SUCCESS_URL=https://resemblio.com/dashboard/credit?topup=success
RESEMBLIO_TOPUP_CANCEL_URL=https://resemblio.com/dashboard/credit?topup=cancel
