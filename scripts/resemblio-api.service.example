# Canonical systemd unit for resemblio-api.service
#
# Source of truth for the production unit body on resemblio-prod-01. Keep this
# file in sync with the deployed unit at /etc/systemd/system/resemblio-api.service.
# Audit reference: projects/OptSus Team/security-audits/2026-05-26-initial.md H4.
#
# Why --workers 1 is mandatory:
#   The FastAPI app's rate limiter (app/rate_limit.py) holds token buckets in a
#   process-local dict. Each uvicorn worker keeps its own ceiling, so any value
#   greater than 1 silently multiplies the documented per-key rate by worker
#   count. app/main.py:validate_worker_concurrency() refuses to start if
#   WEB_CONCURRENCY or UVICORN_WORKERS is set above 1, as a second line of
#   defense; the systemd unit body below is the first.
#
# If real load arrives, migrate rate_limit.py to a Redis-backed store BEFORE
# lifting the worker pin. See the audit dispatch table (H4 path 2).
#
# Apply changes via:
#   sudo cp resemblio-api.service.example /etc/systemd/system/resemblio-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl restart resemblio-api

[Unit]
Description=Resemblio API (FastAPI under uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=claude-cowork
Group=claude-cowork
WorkingDirectory=/opt/resemblio-api/app
EnvironmentFile=/opt/resemblio-api/.env
# Runtime-data root. The API writes per-brand computed-style snapshots and
# (forward) other service-owned data here. This MUST live outside the git
# checkout: pre-2026-06-03 the snapshots wrote into the tracked tree and
# every CI deploy failed at `git reset --hard` because the runtime-owned
# files blocked the unlink. See app/runtime_data.py for the resolver.
Environment=RESEMBLIO_RUNTIME_DATA_ROOT=/var/lib/resemblio
# StateDirectory makes systemd create /var/lib/resemblio at unit start and
# chown it to User/Group above. Avoids a separate provisioning step for
# the runtime root on fresh boxes.
StateDirectory=resemblio
StateDirectoryMode=0755
# --workers 1 is REQUIRED. See header note. Do not change without first
# migrating app/rate_limit.py off the in-memory store.
# --no-server-header strips the default `Server: uvicorn` response header at
# the protocol layer. The equivalent FastAPI middleware in app.main runs
# inside the ASGI chain BEFORE uvicorn writes the Server header on the wire,
# so application-layer deletion is a no-op in production. CI deploy.yml step
# "API security header smoke check" asserts the header is absent on
# https://api.resemblio.com/v1/healthz and gates merges on it.
ExecStart=/opt/resemblio-api/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --no-server-header \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# `/var/lib/resemblio` is the runtime-data root (see Environment= above).
# `StateDirectory=resemblio` makes systemd add it to ReadWritePaths
# automatically, but we list it explicitly here so a future maintainer
# searching for the writable paths finds both in one place.
ReadWritePaths=/opt/resemblio-api /var/lib/resemblio
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
