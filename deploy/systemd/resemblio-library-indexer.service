# Canonical systemd service for resemblio-library-indexer.
#
# Triggered every 60s by resemblio-library-indexer.timer. Invokes
# `python -m app.cli.library_indexer` which drains up to
# LIBRARY_INDEX_BATCH_SIZE rows from `library_index_jobs`, runs the DRL
# compose pipeline for each eligible asset_version, and writes per-page
# renders to `library_pages`.
#
# Hardening mirrors resemblio-idempotency-sweep.service so the indexer
# cannot escape the same filesystem and capability sandbox the API runs
# under. `Type=oneshot` is correct: the worker drains, logs a single
# tick line, and exits 0. Systemd records the success and the timer
# fires again on schedule.
#
# Source of truth lives in the repo at
# `code/api/deploy/systemd/resemblio-library-indexer.service`.
# Apply changes via:
#   sudo cp resemblio-library-indexer.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl restart resemblio-library-indexer.timer

[Unit]
Description=Resemblio library indexer (drain library_index_jobs queue)
After=network-online.target postgresql.service resemblio-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=claude-cowork
Group=claude-cowork
WorkingDirectory=/opt/resemblio-api/app
EnvironmentFile=/opt/resemblio-api/.env
ExecStart=/opt/resemblio-api/venv/bin/python -m app.cli.library_indexer

# Hardening (mirrors resemblio-api.service)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/resemblio-api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
